# Normalise line endings: LF in the repo, native on checkout.
* text=auto eol=lf

# Windows-native scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never diff, never convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.blend binary
*.stl binary
*.glb binary
*.step binary
