# Allowlist .gitignore (AGENT-06 §2.1) — everything is ignored except the
# project's own paths, so a careless `git add .` can never stage anything else.
*
!.gitignore
!.gitattributes
!README.md
!LICENSE
!app/
!app/**
!build/
!build/**
!dist/
!dist/**

# Never track build artefacts or caches anywhere in the tree.
__pycache__/
*.py[cod]